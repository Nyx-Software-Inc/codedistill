# systemd SYSTEM unit for the multi-user, Postgres-backed CodeDistill server.
# Installed by the codedistill-server package; provisioning (Postgres role/db +
# this env file) is done by the package's post-install step.
#
# Activate:   systemctl enable --now codedistill-server
# Status:     systemctl status codedistill-server
# Logs:       journalctl -u codedistill-server -f
#
# Config lives in /etc/codedistill/codedistill.env (DATABASE_URL, the listen
# address, the blob dir, the license path). Edit DATABASE_URL there to use a
# managed/remote Postgres instead of the locally-provisioned one.

[Unit]
Description=CodeDistill server (multi-user, Postgres-backed)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=codedistill
Group=codedistill
# Fallback model for env files written before CODEDISTILL_MODEL existed —
# the EnvironmentFile value wins when present.
Environment=CODEDISTILL_MODEL=qwen2.5:7b
EnvironmentFile=/etc/codedistill/codedistill.env
# DATABASE_URL (Postgres), CODEDISTILL_BLOBS, CODEDISTILL_ADDR, CODEDISTILL_LICENSE,
# CODEDISTILL_MODEL all come from the EnvironmentFile. serve auto-applies
# migrations on startup.
ExecStart=/opt/CodeDistill/bin/codedistill -addr ${CODEDISTILL_ADDR} -model ${CODEDISTILL_MODEL} serve
Restart=on-failure
RestartSec=3

LimitNOFILE=8192
MemoryHigh=3G
MemoryMax=6G

# Hardening — the server only needs to write its blob dir.
ReadWritePaths=/var/lib/codedistill
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
