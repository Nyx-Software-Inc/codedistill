# Built Go binaries at the repo root (rebuilt from source on demand)
/codedistill
/licensegen

# Local databases (single-user dev DB; users keep their own)
/codedistill.db
*.db-journal
*.db-wal
*.db-shm

# Auto pre-upgrade DB snapshots (VACUUM INTO before a migration) and the
# aside-copy `restore` makes before overwriting — safety backups, never tracked.
*.premigrate-*.bak
*.pre-restore-*

# BlobStore content-addressed FS sidecar to the dev DB (Slice 1+).
# Sits next to codedistill.db as <db>.blobs/<sha-prefix>/<sha>.
/codedistill.db.blobs/

# Frontend build deps (regenerated via `npm install`)
web/node_modules/

# macOS .app/.zip build artifacts (regenerated by scripts/build-macos.sh).
# *.dmg kept in the ignore list for legacy artifacts; the current packaging
# emits a .zip after modern macOS rejected our genisoimage hybrid HFS/ISO.
/dist/_stage/
# Generated CE mirror tree — a build artifact, never committed (it would
# carry stale paid code into history). Rebuilt by scripts/build-oss-mirror.sh.
/dist/oss-mirror/
/dist/*.zip
/dist/*.dmg
/dist/codedistill-darwin-arm64
/dist/codedistill-darwin-amd64
/dist/codedistill-linux-amd64
/dist/codedistill-windows-amd64.exe

# OS noise
.DS_Store
Thumbs.db

# Editor noise
.vscode/
.idea/
*.swp
*.swo
*~

# Spike output (regenerated when you re-run the spike)
/spike/data/results.csv
/spike/data/multisample.csv
/spike/usecase-classifier/results-2class.csv
/spike/usecase-classifier/results-4class.csv

# License files are customer secrets — never commit (incl. timestamped backups
# like codedistill.license.bak.<epoch> that the plain *.license glob misses)
*.license
*.license.bak*

# Claim codes are bearer credentials for the remaining seats on a purchase —
# redeem writes one next to the installed license, which lands in the DB's
# directory (i.e. this repo when serve runs from a checkout). Not a *.license
# match, so the globs above miss it.
claim-code

# Brand source images live in the repo root for convenience but are design
# assets, not product code — keep them local, out of the tree.
/CodeDistill.png
/CodeDistill-icon.png
/CodeDistill-logo.png
/Nyx.png
/Nyx-logo.png

# Claude Code MCP config — carries the local write token; machine-local, never commit
.mcp.json

# package build outputs (RPM/deb/DMG land here). Root-anchored — a bare
# `dist/` also matched internal/webui/dist and silently dropped every new
# webui bundle from commits (v0.20.5 shipped referencing missing assets).
/dist/
/activationd
/slavko/
